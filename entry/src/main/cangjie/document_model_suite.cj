// @consolidated-test (generated by consolidate_tests.py)
/**
 * document_model_test.cj
 *
 * Unit tests for the storage-layer Document model and DocDataFormat enum
 * (eudi_cjwallet_storage.storage.types).
 *
 * These tests exercise the pure, device-runnable logic of the storage layer:
 *   - Document convenience/full constructors and field plumbing
 *   - Document.newId() uniqueness (regression guard for the same-second id
 *     collision bug fixed in commit ee699be — ids created back-to-back must be
 *     distinct so a second saveDocument does not overwrite the first)
 *   - getDataForTransfer() tuple plumbing
 *   - DocDataFormat rawValue / describe / fromRaw round-trips
 *
 * No UIAbilityContext is required, so these run on-device under
 * OpenHarmonyTestRunner without an RDB/HUKS environment.
 */
package ohos_app_cangjie_entry
import std.unittest.*
import std.unittest.testmacro.*

import ohos_app_cangjie_eudi_cjwallet_storage.storage.types.Document
import ohos_app_cangjie_eudi_cjwallet_storage.storage.types.DocDataFormat
import ohos_app_cangjie_eudi_cjwallet_storage.storage.types.DocumentStatus

@Test
class DocDataFormatTest {

    @TestCase
    func testRawValue(): Unit {
        @Expect(DocDataFormat.Cbor.rawValue(), "cbor")
        @Expect(DocDataFormat.Sdjwt.rawValue(), "sjwt")
    }

    @TestCase
    func testDescribe(): Unit {
        @Expect(DocDataFormat.Cbor.describe(), "mso_mdoc")
        @Expect(DocDataFormat.Sdjwt.describe(), "vc+sd-jwt")
    }

    @TestCase
    func testFromRawKnown(): Unit {
        match (DocDataFormat.fromRaw("cbor")) {
            case Some(f) => @Expect(f.rawValue(), "cbor")
            case None => @Expect(false)
        }
        match (DocDataFormat.fromRaw("sjwt")) {
            case Some(f) => @Expect(f.rawValue(), "sjwt")
            case None => @Expect(false)
        }
    }

    @TestCase
    func testFromRawUnknown(): Unit {
        @Expect(DocDataFormat.fromRaw("unknown").isNone())
        @Expect(DocDataFormat.fromRaw("").isNone())
    }

    @TestCase
    func testRoundTrip(): Unit {
        let original = DocDataFormat.Cbor
        match (DocDataFormat.fromRaw(original.rawValue())) {
            case Some(f) => @Expect(f.rawValue(), original.rawValue())
            case None => @Expect(false)
        }
    }
}

@Test
class DocumentConstructorTest {

    @TestCase
    func testConvenienceConstructorDefaults(): Unit {
        let data: Array<UInt8> = [0x01u8, 0x02u8, 0x03u8]
        let doc = Document(
            "org.iso.18013.5.1.mDL",
            DocDataFormat.Cbor,
            data,
            None,
            None,
            Some("My Licence"),
            DocumentStatus.Issued
        )
        @Expect(doc.docType, "org.iso.18013.5.1.mDL")
        @Expect(doc.docDataFormat.rawValue(), "cbor")
        @Expect(doc.data.size, 3)
        @Expect(doc.data[0], 0x01u8)
        @Expect(doc.keyIndex, 0)
        @Expect(doc.modifiedAt.isNone())
        @Expect(doc.docKeyInfo.isNone())
        match (doc.displayName) {
            case Some(n) => @Expect(n, "My Licence")
            case None => @Expect(false)
        }
        @Expect(doc.status.rawValue(), "issued")
    }

    @TestCase
    func testIdIsNonEmptyAndPrefixed(): Unit {
        let doc = Document(
            "t",
            DocDataFormat.Cbor,
            [0x00u8],
            None,
            None,
            None,
            DocumentStatus.Issued
        )
        @Expect(doc.id.size > 0)
        @Expect(doc.id.startsWith("doc-"))
    }

    @TestCase
    func testStatusHelpers(): Unit {
        let issued = Document(
            "t", DocDataFormat.Cbor, [0x00u8], None, None, None, DocumentStatus.Issued)
        @Expect(issued.isDeferred(), false)
        @Expect(issued.statusDescription(), "issued")

        let deferred = Document(
            "t", DocDataFormat.Cbor, [0x00u8], None, None, None, DocumentStatus.Deferred)
        @Expect(deferred.isDeferred(), true)
        @Expect(deferred.statusDescription(), "deferred")
    }
}

@Test
class DocumentNewIdUniquenessTest {

    /**
     * Regression guard for commit ee699be: two documents created back-to-back
     * (within the same wall-clock second/millisecond) must receive distinct ids.
     * Before the fix, second-granularity timestamps produced id collisions which
     * caused the second saveDocument to overwrite the first (data loss / empty
     * loadDocuments(Issued)).
     */
    @TestCase
    func testBackToBackIdsAreDistinct(): Unit {
        let d1 = Document(
            "t", DocDataFormat.Cbor, [0xAAu8], None, None, None, DocumentStatus.Issued)
        let d2 = Document(
            "t", DocDataFormat.Cbor, [0xBBu8], None, None, None, DocumentStatus.Deferred)
        @Expect(d1.id != d2.id)
    }

    @TestCase
    func testManyIdsAreDistinct(): Unit {
        let n = 20
        let ids = Array<String>(n, repeat: "")
        for (i in 0..n) {
            let doc = Document(
                "t", DocDataFormat.Cbor, [0x00u8], None, None, None, DocumentStatus.Issued)
            ids[i] = doc.id
        }
        // every id must be unique: compare each pair
        for (i in 0..n) {
            for (j in (i + 1)..n) {
                @Expect(ids[i] != ids[j])
            }
        }
    }
}

@Test
class DocumentGetDataForTransferTest {

    @TestCase
    func testTransferTupleCarriesIdAndData(): Unit {
        let data: Array<UInt8> = [0xDEu8, 0xADu8, 0xBEu8, 0xEFu8]
        let doc = Document(
            "org.iso.18013.5.1.mDL",
            DocDataFormat.Sdjwt,
            data,
            Some([0x11u8]),
            Some([0x22u8]),
            Some("Transfer Doc"),
            DocumentStatus.Pending
        )
        let (docPair, metaPair, fmtPair, keyPair) = doc.getDataForTransfer()

        // doc bytes pair
        @Expect(docPair[0], doc.id)
        @Expect(docPair[1].size, 4)
        @Expect(docPair[1][0], 0xDEu8)

        // format pair carries the raw value
        @Expect(fmtPair[0], doc.id)
        @Expect(fmtPair[1], "sjwt")

        // metadata pair is Some
        @Expect(metaPair[0], doc.id)
        match (metaPair[1]) {
            case Some(m) => @Expect(m[0], 0x22u8)
            case None => @Expect(false)
        }

        // key info pair is Some
        match (keyPair[1]) {
            case Some(k) => @Expect(k[0], 0x11u8)
            case None => @Expect(false)
        }
    }

    @TestCase
    func testTransferTupleHandlesNoneMetadata(): Unit {
        let doc = Document(
            "t", DocDataFormat.Cbor, [0x00u8], None, None, None, DocumentStatus.Issued)
        let (_, metaPair, _, keyPair) = doc.getDataForTransfer()
        @Expect(metaPair[1].isNone())
        @Expect(keyPair[1].isNone())
    }
}
